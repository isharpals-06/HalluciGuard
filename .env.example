# HalluciGuard-OKF Environment Configuration

# Optional Cloud Providers (Leave blank for local offline mode)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Pipeline Defaults
HALLUCIGUARD_PROVIDER=local
HALLUCIGUARD_ABSTAIN_THRESHOLD=0.60
HALLUCIGUARD_MIN_RELEVANCE=0.35

# Logging & Telemetry
LOG_LEVEL=INFO
